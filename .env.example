# Required by the current application. Use `npm run db:start` and
# `npx supabase status` for local values, or the staging project values from
# Supabase Settings > API Keys when intentionally using the hosted project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: account creation uses it for the Auth admin API (src/lib/supabase/admin.ts). Locally, use the
# secret key that `npx supabase status` prints. Also reserved for trusted server-side workers.
# Create a dedicated `sb_secret_...` key in Supabase Settings > API Keys.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=

# Reserved for absolute application links and authentication redirects.
# Staging: https://takusani-lms.vercel.app
# .env.local (Development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authenticates Vercel Cron's calls to the scheduled jobs (/api/internal/jobs/*). Generate an independent,
# random value of at least 16 characters; do not reuse another credential. Without it the jobs refuse every call.
CRON_SECRET=

# Notification email (S2-10). Locally, send to the Supabase stack's mail catcher (http://127.0.0.1:54324):
#   EMAIL_PROVIDER=mailpit
# On a deployment, Resend (it honours the idempotency key each send carries, ADR-025):
#   EMAIL_PROVIDER=resend and RESEND_API_KEY=re_... (server only; never NEXT_PUBLIC_)
# Email is switched off until go-live: leave this unset. In-app notifications still work. Switching email on also
# needs the database switch (docs/development/README.md, Notifications).
EMAIL_PROVIDER=
EMAIL_FROM=Takusani LMS <lms@takusani.test>
RESEND_API_KEY=

# Staging scripts run from a developer machine (npm run accounts:staging; docs/development/README.md). Prefixed
# STAGING_ so they never override the local settings above: the Supabase CLI reads .env.local too.
STAGING_SUPABASE_URL=https://mfgaoqabgboegovodklq.supabase.co
# Public by design; used by `node --env-file=.env.local scripts/check-data-api-exposure.mjs staging`.
STAGING_SUPABASE_PUBLISHABLE_KEY=
STAGING_SUPABASE_SECRET_KEY=
STAGING_TEST_ACCOUNT_PASSWORD=
