# Required by the current application. Use `npm run db:start` and
# `npx supabase status` for local values, or the staging project values from
# Supabase Settings > API Keys when intentionally using the hosted project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reserved for trusted server-side workers and administrative operations.
# Create a dedicated `sb_secret_...` key in Supabase Settings > API Keys.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=

# Reserved for absolute application links and authentication redirects.
# Staging: https://takusani-lms.vercel.app
# .env.local (Development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reserved for authenticated Vercel Cron requests. Generate an independent,
# random value of at least 16 characters; do not reuse another credential.
CRON_SECRET=

# Local development only, ignored in production builds. Comma-separated roles to preview the navigation
# until real sign-in exists: learner, facilitator, assessor, moderator, coordinator, administrator, reviewer.
LMS_DEV_ROLES=
